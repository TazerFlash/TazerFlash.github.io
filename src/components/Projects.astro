---
import { projects } from '../content';
import { rich } from '../lib/rich';
import Section from './Section.astro';
import Chip from './Chip.astro';
import Icon from './Icon.astro';

// Highlights shown before the "Show more" toggle, so the panel fits one screen.
const SHOWN = 2;
const bullet =
  'relative pl-5 before:absolute before:top-[0.7em] before:left-0 before:h-px before:w-2.5 before:bg-muted/60';
---

<Section id="projects" index="03" title="Projects">
  <div data-reveal>
    <div role="tablist" aria-label="Projects" class="no-scrollbar relative -mx-5 flex gap-2 overflow-x-auto px-5 sm:mx-0 sm:px-0">
      {
        projects.map((p, i) => (
          <button
            type="button"
            role="tab"
            id={`project-tab-${i}`}
            aria-controls={`project-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="shrink-0 rounded-lg border border-line px-3.5 py-2 text-sm font-medium text-muted transition-colors hover:bg-surface hover:text-fg aria-selected:border-accent aria-selected:bg-accent-soft aria-selected:text-fg"
          >
            {p.short}
          </button>
        ))
      }
    </div>

    {
      projects.map((p, i) => {
        const links = p.links.filter((l) => l.href);
        return (
          <article
            role="tabpanel"
            id={`project-${i}`}
            aria-labelledby={`project-tab-${i}`}
            tabindex="0"
            data-inactive={i === 0 ? undefined : ''}
            class="mt-5 grid gap-6 rounded-xl border border-line bg-bg p-6 outline-offset-4 sm:p-7 md:grid-cols-2 md:gap-10"
          >
            <div class="flex flex-col">
              <h3 class="text-lg font-semibold tracking-tight text-fg">{p.title}</h3>
              <p class="mt-2 text-sm text-muted">{p.description}</p>
              {p.status && (
                <p class="mt-3 flex items-start gap-2 font-mono text-xs text-muted">
                  <span class="mt-[5px] h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                  {p.status}
                </p>
              )}

              <ul class="mt-5 flex flex-wrap gap-2" aria-label="Key results">
                {p.metrics.map((m) => (
                  <li>
                    <Chip variant="metric">{m}</Chip>
                  </li>
                ))}
              </ul>

              <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Technologies">
                {p.tags.map((t) => (
                  <li>
                    <Chip>{t}</Chip>
                  </li>
                ))}
              </ul>

              {links.length > 0 && (
                <div class="mt-auto flex gap-4 pt-6">
                  {links.map((l) => (
                    <a
                      href={l.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 text-sm font-medium text-fg hover:text-accent"
                    >
                      <Icon name="github" /> {l.label}
                      <span class="sr-only">repository for {p.title} (opens in a new tab)</span>
                      <Icon name="external" class="h-3.5 w-3.5 text-muted" />
                    </a>
                  ))}
                </div>
              )}
            </div>

            <div class="text-sm text-muted md:border-l md:border-line md:pl-10">
              <ul class="space-y-3">
                {p.highlights.slice(0, SHOWN).map((h) => (
                  <li class={bullet}>
                    <Fragment set:html={rich(h)} />
                  </li>
                ))}
              </ul>
              {p.highlights.length > SHOWN && (
                <details class="group mt-3">
                  <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded font-mono text-xs text-accent [&::-webkit-details-marker]:hidden">
                    <span class="group-open:hidden">Show {p.highlights.length - SHOWN} more</span>
                    <span class="hidden group-open:inline">Show less</span>
                    <svg class="h-3 w-3 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                  </summary>
                  <ul class="mt-3 space-y-3">
                    {p.highlights.slice(SHOWN).map((h) => (
                      <li class={bullet}>
                        <Fragment set:html={rich(h)} />
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </div>
          </article>
        );
      })
    }
  </div>
</Section>

<script>
  import { initTabs } from '../lib/tabs';
  initTabs();
</script>
