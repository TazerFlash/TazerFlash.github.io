---
interface Props {
  variant?: 'metric' | 'tag';
}
const { variant = 'tag' } = Astro.props;
---

{
  variant === 'metric' ? (
    <span class="inline-flex items-center rounded-md bg-accent-soft px-2 py-1 font-mono text-xs font-medium text-accent">
      <slot />
    </span>
  ) : (
    <span class="inline-flex items-center rounded-md border border-line px-2 py-1 font-mono text-xs text-muted">
      <slot />
    </span>
  )
}
