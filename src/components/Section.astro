---
interface Props {
  id: string;
  index: string;
  title: string;
  intro?: string;
}
const { id, index, title, intro } = Astro.props;
---

<section
  id={id}
  data-panel
  tabindex="-1"
  aria-labelledby={`${id}-title`}
  class="relative h-full w-full shrink-0 snap-start snap-always overflow-y-auto overscroll-y-contain outline-none"
>
  <div class="mx-auto flex min-h-full max-w-5xl flex-col justify-center px-5 py-12 sm:px-8 sm:py-16">
    <header data-reveal class="mb-8 sm:mb-12">
      <p class="font-mono text-xs tracking-wider text-accent uppercase">{index} / {id}</p>
      <h2 id={`${id}-title`} class="mt-3 text-2xl font-semibold tracking-tight text-fg sm:text-3xl">{title}</h2>
      {intro && <p class="mt-3 max-w-2xl text-muted">{intro}</p>}
    </header>
    <slot />
  </div>
</section>
