---
import { nav } from '../content';

const panels = [{ id: 'top', label: 'Home' }, ...nav];
---

<nav aria-label="Sections" class="shrink-0 border-t border-line bg-bg">
  <div class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-4 px-5 sm:px-8">
    <p class="min-w-0 truncate font-mono text-xs text-muted" aria-live="polite">
      <span data-pager-count>01 / {String(panels.length).padStart(2, '0')}</span>
      <span class="mx-2 text-line" aria-hidden="true">|</span>
      <span data-pager-label class="text-fg">{panels[0].label}</span>
    </p>

    <ol class="hidden items-center gap-1 sm:flex">
      {
        panels.map((p, i) => (
          <li>
            <a
              href={`#${p.id}`}
              data-pager-dot
              aria-label={p.label}
              aria-current={i === 0 ? 'true' : undefined}
              class="group grid h-8 w-6 place-items-center"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-line transition-all group-hover:bg-muted group-aria-[current=true]:w-5 group-aria-[current=true]:bg-accent" />
            </a>
          </li>
        ))
      }
    </ol>

    <div class="flex items-center gap-1">
      <button
        type="button"
        data-pager-prev
        aria-label="Previous section"
        disabled
        class="grid h-9 w-9 place-items-center rounded-md border border-line text-fg transition-colors hover:border-fg disabled:cursor-default disabled:opacity-35 disabled:hover:border-line"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m6 6-6-6 6-6" /></svg>
      </button>
      <button
        type="button"
        data-pager-next
        aria-label="Next section"
        class="grid h-9 w-9 place-items-center rounded-md border border-line text-fg transition-colors hover:border-fg disabled:cursor-default disabled:opacity-35 disabled:hover:border-line"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
      </button>
    </div>
  </div>
</nav>

<script>
  // Horizontal panel navigation: pager buttons, in-page links, mouse wheel and arrow keys.
  const track = document.querySelector<HTMLElement>('[data-track]')!;
  const panels = [...track.querySelectorAll<HTMLElement>('[data-panel]')];
  const ids = panels.map((p) => p.id);
  const labels = [...document.querySelectorAll<HTMLAnchorElement>('[data-pager-dot]')].map(
    (a) => a.getAttribute('aria-label') ?? '',
  );
  const count = document.querySelector('[data-pager-count]')!;
  const label = document.querySelector('[data-pager-label]')!;
  const prev = document.querySelector<HTMLButtonElement>('[data-pager-prev]')!;
  const next = document.querySelector<HTMLButtonElement>('[data-pager-next]')!;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const pad = (n: number) => String(n).padStart(2, '0');

  let current = -1;
  const indexFromScroll = () => Math.round(track.scrollLeft / track.clientWidth);

  function render(i: number) {
    if (i === current) return;
    current = i;
    count.textContent = `${pad(i + 1)} / ${pad(panels.length)}`;
    label.textContent = labels[i];
    prev.disabled = i === 0;
    next.disabled = i === panels.length - 1;
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link], [data-pager-dot]').forEach((a) => {
      if (a.hash === `#${ids[i]}`) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });
    history.replaceState(null, '', i === 0 ? location.pathname : `#${ids[i]}`);
  }

  function go(i: number, focus = false) {
    const target = Math.max(0, Math.min(panels.length - 1, i));
    track.scrollTo({ left: target * track.clientWidth, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
    if (focus) panels[target].focus({ preventScroll: true });
  }

  // Open on the panel named in the URL hash, if any.
  const start = ids.indexOf(location.hash.slice(1));
  if (start > 0) track.scrollLeft = start * track.clientWidth;
  render(indexFromScroll());

  let ticking = false;
  track.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        render(indexFromScroll());
        ticking = false;
      });
    },
    { passive: true },
  );

  // Keep the current panel aligned when the window is resized.
  new ResizeObserver(() => (track.scrollLeft = current * track.clientWidth)).observe(track);

  prev.addEventListener('click', () => go(current - 1));
  next.addEventListener('click', () => go(current + 1));

  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
    if (!link) return;
    const i = ids.indexOf(link.hash.slice(1));
    if (i < 0) return;
    e.preventDefault();
    go(i, true);
  });

  // Vertical wheel moves sideways, unless the current panel still has content to scroll through.
  let locked = false;
  track.addEventListener(
    'wheel',
    (e) => {
      if (e.ctrlKey || Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
      const panel = panels[current];
      const down = e.deltaY > 0;
      const canScroll = down
        ? panel.scrollTop + panel.clientHeight < panel.scrollHeight - 2
        : panel.scrollTop > 2;
      if (canScroll) return;
      e.preventDefault();
      if (locked || Math.abs(e.deltaY) < 4) return;
      locked = true;
      go(current + (down ? 1 : -1));
      setTimeout(() => (locked = false), 750);
    },
    { passive: false },
  );

  document.addEventListener('keydown', (e) => {
    if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
    const t = e.target as HTMLElement;
    if (t.closest('input, textarea, select, [role="tablist"]')) return;
    if (e.key === 'ArrowRight') {
      e.preventDefault();
      go(current + 1);
    } else if (e.key === 'ArrowLeft') {
      e.preventDefault();
      go(current - 1);
    }
  });
</script>
