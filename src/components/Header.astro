---
import { nav, site } from '../content';
import Icon from './Icon.astro';
---

<header class="relative z-40 shrink-0 border-b border-line bg-bg">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5 sm:px-8">
    <a href="#top" class="group flex items-center gap-2.5 font-semibold tracking-tight text-fg">
      <span
        class="grid h-7 w-7 place-items-center rounded-md bg-fg font-mono text-[11px] font-medium text-bg transition-colors group-hover:bg-accent group-hover:text-accent-ink"
        aria-hidden="true">{site.initials}</span
      >
      <span>{site.name}</span>
    </a>

    <nav aria-label="Primary" class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 md:flex">
        {
          nav.map((item) => (
            <li>
              <a
                href={`#${item.id}`}
                data-nav-link
                class="rounded-md px-3 py-2 text-sm text-muted transition-colors hover:text-fg aria-[current=true]:text-fg aria-[current=true]:bg-surface"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle dark theme"
        class="grid h-10 w-10 place-items-center rounded-md text-muted transition-colors hover:bg-surface hover:text-fg"
      >
        <span class="hidden dark:block"><Icon name="sun" class="h-[18px] w-[18px]" /></span>
        <span class="block dark:hidden"><Icon name="moon" class="h-[18px] w-[18px]" /></span>
      </button>

      <button
        type="button"
        id="menu-button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid h-10 w-10 place-items-center rounded-md text-muted transition-colors hover:bg-surface hover:text-fg md:hidden"
      >
        <Icon name="menu" class="h-5 w-5" />
      </button>
    </nav>
  </div>

  <div id="mobile-menu" hidden class="absolute inset-x-0 top-full border-y border-line bg-bg shadow-lg md:hidden">
    <ul class="mx-auto max-w-5xl px-5 py-3">
      {
        nav.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              data-nav-link
              class="block rounded-md px-2 py-3 text-fg hover:bg-surface aria-[current=true]:text-accent"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const button = document.getElementById('menu-button')!;
  const menu = document.getElementById('mobile-menu')!;
  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  button.addEventListener('click', () => setOpen(menu.hidden));
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) {
      setOpen(false);
      button.focus();
    }
  });
</script>
