---
import { contact, site } from '../content';
import Section from './Section.astro';
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL;
const links = [
  { label: 'LinkedIn', href: contact.linkedin, icon: 'linkedin' as const },
  { label: 'GitHub', href: contact.github, icon: 'github' as const },
].filter((l) => l.href);
---

<Section
  id="contact"
  index="06"
  title="Get in touch"
  intro="Open to conversations about Product Data Science and Generative AI roles. Email is the fastest way to reach me."
>
  <div data-reveal class="rounded-xl border border-line bg-surface p-6 sm:p-10">
    <a
      href={`mailto:${contact.email}`}
      class="inline-flex items-center gap-3 text-xl font-semibold tracking-tight break-all text-fg underline decoration-line decoration-2 underline-offset-8 transition-colors hover:text-accent hover:decoration-accent sm:text-3xl"
    >
      <Icon name="mail" class="h-6 w-6 shrink-0" />
      {contact.email}
    </a>

    <div class="mt-8 flex flex-wrap gap-3">
      {
        links.map((l) => (
          <a
            href={l.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-line bg-bg px-4 py-2.5 text-sm font-medium text-fg transition-colors hover:border-fg"
          >
            <Icon name={l.icon} /> {l.label}
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        ))
      }
      <a
        href={`${base}${site.resume}`}
        download
        class="inline-flex items-center gap-2 rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-accent-ink transition-opacity hover:opacity-90"
      >
        <Icon name="download" /> Download Resume
      </a>
    </div>
  </div>

  <footer class="mt-10 flex flex-col gap-1 text-sm text-muted sm:flex-row sm:justify-between">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <p class="font-mono text-xs">Built with Astro &amp; Tailwind CSS</p>
  </footer>
</Section>
